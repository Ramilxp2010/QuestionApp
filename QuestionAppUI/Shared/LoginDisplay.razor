@using QuestionAppUI.Authentication;
@inject NavigationManager navManager

<AuthorizeView Roles="Admin">
    <a class="login-link" href="/AdminPanel">Admin Panel</a>
    <a class="login-link" href="/AdminApproval" style="margin-left:10px;">Admin Approval</a>
    <a class="login-link" href="/SampleData" style="margin-left:10px;">Seed Data</a>
</AuthorizeView>
<AuthorizeView>
    <Authorized>
        <a href="/Profile">Hello, @context.User.Identity?.Name!</a>
        <a style="margin-left:10px;" href="@Urls.LogoutPath">Log out</a>
    </Authorized>
    <NotAuthorized>
        <a href="@Urls.LoginPath">Login</a>
    </NotAuthorized>
</AuthorizeView>
