@page "/SampleData"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using QuestionAppUI.Helpers
@attribute [Authorize(Roles = "Admin")]
@inject ICategoryData categoryData
@inject IStatusData statusData
@inject IQuestionData questionData
@inject IUserData userData
@inject IAnswerData answerData
@inject IPasswordHasher<User> passwordHasher

<h1 class="page-heading text-uppercase mb-4">Seed Data</h1>

<div class="form-layout">
    @if (sampleDataCreated)
    {
        <h4>Sample data ensured (empty collections were filled).</h4>
    }
    else
    {
        <p class="mb-3">Creates demo users, categories, statuses, questions and answers when collections are empty.</p>
        <button class="btn btn-primary" @onclick="GenerateSampleData" disabled="@isBusy">
            @(isBusy ? "Seeding..." : "Generate Sample Data")
        </button>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger mt-3">@errorMessage</div>
    }
</div>

@code {
    private bool sampleDataCreated;
    private bool isBusy;
    private string errorMessage = "";

    private async Task GenerateSampleData()
    {
        isBusy = true;
        errorMessage = "";
        try
        {
            await DemoDataSeeder.EnsureDemoDataAsync(
                userData,
                passwordHasher,
                categoryData,
                statusData,
                questionData,
                answerData);
            sampleDataCreated = true;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }
}
